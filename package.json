{
  "name": "docsync-guard",
  "version": "0.1.0",
  "description": "Catch stale translated Markdown docs before they merge.",
  "type": "module",
  "bin": {
    "docsync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "README.zh-CN.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "documentation",
    "translation",
    "docs",
    "github-action"
  ],
  "author": "taotaotao07",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
